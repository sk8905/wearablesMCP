# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and MUST NOT be committed.

# --- Whoop OAuth2 app credentials (from https://developer.whoop.com) ---
WHOOP_CLIENT_ID=your_whoop_client_id_here
WHOOP_CLIENT_SECRET=your_whoop_client_secret_here

# Redirect URI registered on your Whoop app. Must match exactly.
# Only used during the one-time `authorize_whoop` browser login.
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# --- Garmin Connect credentials (your normal Garmin login) ---
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password_here

# --- Optional tuning ---
# Where local state lives (encrypted token, SQLite cache, Garmin session).
# Defaults to ~/.wearables-mcp if unset.
# DATA_DIR=/home/you/.wearables-mcp

# Refresh cached API responses older than this many hours (default 6).
# CACHE_TTL_HOURS=6
